# ---- Server ----
PORT=8787
APP_URL=http://localhost:5173          # public site URL (emails + Google OAuth redirect)

# ---- Database ----
# sqlite (default: SQL database file server/.data/ya2.db), oracle, or file (JSON, prototype only)
DB_CLIENT=sqlite
# SQLITE_FILE=server/.data/ya2.db
# ORACLE_USER=
# ORACLE_PASSWORD=
# ORACLE_CONNECT_STRING=host:1521/service_name   # tables are created automatically on first start
# ORACLE_WALLET_DIR=                   # Autonomous DB wallet folder (optional)
# ORACLE_WALLET_PASSWORD=

# ---- Hidden admin console (/admin) ----
# Required in production. In development a temporary password is printed in the API log.
# ADMIN_PASSWORD=choose-a-long-password

# ---- Google sign-in (optional) ----
# Authorised redirect URI: ${APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Payments ----
# demo (default, no money moves) | razorpay | stripe
PAYMENT_PROVIDER=demo
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ---- Email (password reset) ----
# SMTP_URL=

# ---- Frontend (build-time) ----
# VITE_WHATSAPP_NUMBER=919876543210    # digits only, with country code (empty: opens WhatsApp Web)
# VITE_INSTAGRAM_USERNAME=
# VITE_SITE_URL=https://www.example.com
