# ---- Server ----
PORT=8787
APP_URL=http://localhost:5173          # public site URL (emails + Google OAuth redirect)

# ---- Database ----
# file (default, JSON in server/.data) or oracle
DB_CLIENT=file
# ORACLE_USER=
# ORACLE_PASSWORD=
# ORACLE_CONNECT_STRING=host:1521/service_name
# ORACLE_WALLET_DIR=                   # Autonomous DB wallet folder (optional)
# ORACLE_WALLET_PASSWORD=

# ---- Google sign-in (optional) ----
# Authorised redirect URI: ${APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- Payments ----
# demo (default, no money moves) | razorpay | stripe
PAYMENT_PROVIDER=demo
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ---- Email (password reset) ----
# SMTP_URL=

# ---- Frontend (build-time) ----
# VITE_WHATSAPP_NUMBER=919876543210    # digits only, with country code
# VITE_INSTAGRAM_USERNAME=
# VITE_SITE_URL=https://www.example.com
