# Public URL of the live site (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Admin panel (hidden at /hc-admin) ──────────────────────────────
# Password for the admin sign-in (8+ characters). Admin is disabled if unset.
ADMIN_PASSWORD=
# Long random string used to sign admin sessions (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=

# ── Supabase (catalogue, photos, enquiries, settings) ──────────────
# Server-side only — never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
