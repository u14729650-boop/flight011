# Public URL of the live site (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Admin panel (hidden at /hc-admin) ──────────────────────────────
# Admin sign-in. Admin is disabled if the password is unset (8+ characters).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Long random string used to sign admin sessions (e.g. `openssl rand -hex 32`).
ADMIN_SESSION_SECRET=

# ── Supabase (catalogue, photos, orders, enquiries, settings) ──────
# Vercel's Supabase integration adds all three automatically.
# Server-side only — never put the service-role key in a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection: when set, every build creates/updates the tables
# from supabase/schema.sql (scripts/setup-database.mjs).
POSTGRES_URL_NON_POOLING=
